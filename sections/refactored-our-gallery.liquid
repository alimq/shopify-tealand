{{ 'refactored-our-gallery.css' | asset_url | stylesheet_tag }}
<div class="our-gallery">
    <div class="container">
        <p class="hero-title hero-title-font">
            OUR GALLERY
        </p>
        <div class="text-btn-row">
            <p class="our-unique-title hero-second-title hero-second-title-font">
                You Too Can Have A Tea Like Mine
            </p>
            <button class="hero-button">
                Explore
            </button>
        </div>
        {% for product in collections['Gallery-1'].products %}
        <div class="g-item">
            <picture class="g-item-pic">
                <source media="(max-width: 419px)" srcset="{{ product.metafields.custom.svg_icon | image_url: width: auto }}">
                <source media="(min-width: 420px)" srcset="{{ product.featured_image | image_url: width: auto }}">
                <img src="{{ product.featured_image | image_url: width: auto }}" class="">
            </picture>
        </div>
        {% endfor %}
        <div class="second-combo">
            {% for product in collections['Gallery-2'].products %}
            <div class="g-item">
                <picture class="g-item-pic">
                    <source media="(max-width: 419px)" srcset="{{ product.metafields.custom.svg_icon | image_url: width: auto }}">
                    <source media="(min-width: 420px)" srcset="{{ product.featured_image | image_url: width: auto }}">
                    <img src="{{ product.featured_image | image_url: width: auto }}" class="">
                </picture>
            </div>
            {% endfor %}
        </div>
        <div class="third-combo">
            {% for product in collections['Gallery'].products %}
            <div class="g-item">
                <picture class="g-item-pic">
                    <source media="(max-width: 419px)" srcset="{{ product.metafields.custom.svg_icon | image_url: width: auto }}">
                    <source media="(min-width: 420px)" srcset="{{ product.featured_image | image_url: width: auto }}">
                    <img src="{{ product.featured_image | image_url: width: auto }}" class="">
                </picture>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% schema %}
{
    "name": "Our Gallery section",
    "settings": [],
    "presets": [
        {
            "name": "Our Gallery section"
        }
    ]
}
{% endschema %}