{{ 'refactored-footer.css' | asset_url | stylesheet_tag }}
<div class="footer">
    <div class="container">
        <div class="front">
            <p class="hero-second-title second-title-font">
                Get In Touch
            </p>
            <p>+012-345-6789</p>
            <p>Tealand@contact.com</p>
            <p>9889 Lorem Ipsum Street, Pellentesque, CA, USA</p>
        </div>
        <div class="mid">
            <picture class="footer-logo">
                <source media="
                (max-width: 419px)" srcset="">
                <source media="{{
                    'logo.svg' | asset_url
                }}
                (min-width: 420px)" srcset="{{
                    'logo.png' | asset_url
                }}">
                <img class="footer-logo" src="
                {{ 'logo.png' | asset_url }}">
            </picture>
            <picture class="sn-logo">
                <source media="
                (max-width: 419px)" srcset="">
                <source media="{{
                    'twitter.svg' | asset_url
                }}
                (min-width: 420px)" srcset="{{
                    'twitter.png' | asset_url
                }}">
                <img class="sn-logo" src="
                {{ 'twitter.png' | asset_url }}">
            </picture>
            <picture class="sn-logo">
                <source media="
                (max-width: 419px)" srcset="">
                <source media="{{
                    'insta.svg' | asset_url
                }}
                (min-width: 420px)" srcset="{{
                    'insta.png' | asset_url
                }}">
                <img class="sn-logo" src="
                {{ 'insta.png' | asset_url }}">
            </picture>
            <picture class="sn-logo">
                <source media="
                (max-width: 419px)" srcset="">
                <source media="{{
                    'tiktok.svg' | asset_url
                }}
                (min-width: 420px)" srcset="{{
                    'tiktok.png' | asset_url
                }}">
                <img class="sn-logo" src="
                {{ 'tiktok.png' | asset_url }}">
            </picture>
            <picture class="sn-logo">
                <source media="
                (max-width: 419px)" srcset="">
                <source media="{{
                    'sn.svg' | asset_url
                }}
                (min-width: 420px)" srcset="{{
                    'sn.png' | asset_url
                }}">
                <img class="sn-logo" src="
                {{ 'sn.png' | asset_url }}">
            </picture>
        </div>
        <div class="back">
            <p class="hero-second-title second-title-font">
                Working Hours
            </p>
            <p>Monday/Friday 9:00-23:00</p>
            <p>Saturday 10:00-21:00</p>
            <p>Weekend Closed</p>
            <picture class="up-pic">
                <source media="
                (max-width: 419px)" srcset="">
                <source media="{{
                    'up-pic.svg' | asset_url
                }}
                (min-width: 420px)" srcset="{{
                    'up-pic.png' | asset_url
                }}">
                <img class="sn-logo" src="
                {{ 'up-pic.png' | asset_url }}">
            </picture>
        </div>
        <div class="footer-bottom">
            <p>Copyright Dotcreativemarket</p>
        </div>
    </div>
</div>
{% schema %}
{
    "name": "Footer section",
    "settings": [],
    "presets": [
        {
            "name": "Footer section"
        }
    ]
}
{% endschema %}