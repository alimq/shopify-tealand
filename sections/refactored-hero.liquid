{{ 'refactored-hero.css' | asset_url | stylesheet_tag }}
<div class="hero">
    {% render 'refactored-hero-bg' %}
    {% render 'refactored-hero-logo' %}
    {% render 'refactored-hero-left-menu' %}
    {% render 'refactored-hero-right-menu' %}
